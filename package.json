{
  "name": "@deepseek-ai/dsh-functional-logic-completion-v2-1",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "需求功能逻辑补全 v2.1 — 分层功能、用例图和活动图的 Run 后端插件",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "python/**/*.py",
    "requirements",
    "scripts/prepare-python.mjs",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "tools/README.md",
    "tools/plantuml.jar",
    "tools/plantuml-LICENSE.txt",
    "tools/plantuml-NOTICE.md",
    "tools/plantuml-licenses",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test:entry": "node --experimental-transform-types --test tests/run-entry.test.ts",
    "prepare:python": "node scripts/prepare-python.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@software-factory/runtime-sdk": "file:vendor/software-factory-runtime-sdk-0.3.0.tgz"
  }
}
